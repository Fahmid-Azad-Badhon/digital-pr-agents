# Jina AI API Key (free)
# Get your key at: https://jina.ai/reader
# Free tier: 100 RPM for search, 500 RPM for reader
JINA_API_KEY=your_jina_api_key_here

# LLM API Key (Stage 4 AI enhancement + all LLM stages)
# Free models served via OpenRouter. Set either key; falls back to anonymous 'free' tier.
# OPENROUTER_API_KEY: https://openrouter.ai/keys
# OPENCODE_API_KEY: used by the local OpenCode runtime when OpenRouter key is absent
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENCODE_API_KEY=

# Internal mutation audit bridge token (required for middleware->internal audit logging)
INTERNAL_AUDIT_TOKEN=change_me_to_a_long_random_secret

# Dashboard base URL used for internal self-referencing (brain worker API calls)
DASHBOARD_BASE_URL=http://localhost:3002

# Dashboard auth + role policies
DASHBOARD_AUTH_REQUIRED=true
DASHBOARD_API_TOKEN=change_me_dashboard_api_token
DASHBOARD_API_TOKEN_ROLE=admin
# Optional JSON map of additional static tokens -> role: {"token1":"operator"}
DASHBOARD_API_TOKENS_JSON=
# Optional JSON map of extra route prefixes -> role (merged over defaults)
# Example: {"\/api\/brains\/run":"admin","\/api\/campaigns\/":"operator"}
DASHBOARD_ROUTE_POLICIES_JSON=
# Set to 'false' to skip the Origin-header cross-origin mutation check (defaults to enabled)
DASHBOARD_ENFORCE_ORIGIN=
DASHBOARD_SESSION_SECRET=change_me_session_secret
# Example: {"admin":{"password":"change_me","role":"admin"},"ops":{"password":"change_me","role":"operator"}}
DASHBOARD_AUTH_USERS_JSON=
DASHBOARD_SESSION_TTL_SECONDS=43200
# Session-authenticated mutation requests must send header:
# x-csrf-token: <value returned by /api/auth/login or /api/auth/me>
# Browser-side client sets the same token as a header on mutations:
NEXT_PUBLIC_DASHBOARD_API_TOKEN=

# Workflow runtime flags
# 'false' disables strict real-data enforcement (default: strict on)
STRICT_REAL_ONLY=
# 'true' allows dev mock artifacts where strict mode would block
ALLOW_DEV_MOCK_ARTIFACTS=
# Run mode override: local | manual | api (default: derived from env)
RUN_MODE=

# Externalization rollout mode
# local | staging | production
EXTERNALIZATION_MODE=local

# Google production externalization flags
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=http://localhost:3002/api/integrations/google/callback
GOOGLE_OAUTH_APP_VERIFIED=
GOOGLE_OAUTH_PUBLISH_STATUS=

# Muck Rack production externalization flags
MUCKRACK_API_KEY=
MUCKRACK_SESSION_COOKIE=
MUCKRACK_EMAIL=
MUCKRACK_PASSWORD=
MUCKRACK_DEBUG_PORT=9333
MUCKRACK_CHROME_PROFILE_DIR=
MUCKRACK_COLLECTION_CONCURRENCY=
MUCKRACK_MAX_RETRIES=
MUCKRACK_ROBUSTNESS_APPROVED=

# Alternate debug ports probed by integration readiness (aliases of MUCKRACK_DEBUG_PORT)
CHROME_DEBUG_PORT=
PUPPETEER_DEBUG_PORT=

# Structured logging (optional OTEL/HTTP collector). Empty = console logging only.
OTEL_LOG_ENDPOINT=
OTEL_LOG_API_KEY=
